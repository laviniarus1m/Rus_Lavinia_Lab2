@page "{id:int?}"
@model Rus_Lavinia_Lab2.Pages.CategoryPages.IndexModel

@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

<p><a asp-page="Create">Create New</a></p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Category[0].CategoryName)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Category)
        {
            <tr class="@(item.ID == Model.CategoryID ? "table-success" : "")">
                <td>@item.CategoryName</td>
                <td>
                    <a asp-page="./Index" asp-route-id="@item.ID">Select</a> |
                    <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.CategoryID.HasValue)
{
    <h3>Books in Selected Category</h3>
    <table class="table">
        <thead>
            <tr><th>Book Title</th><th>Author</th></tr>
        </thead>
        <tbody>
            @foreach (var book in Model.Books)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@(book.Authors != null ? book.Authors.FullName : book.Author)</td>
                </tr>
            }
        </tbody>
    </table>
}
